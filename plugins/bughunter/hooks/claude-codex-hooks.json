{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-router.js\" session",
            "timeout": 5,
            "statusMessage": "Loading OhMyBug review gate..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/version-check.sh",
            "timeout": 5,
            "statusMessage": "Checking OhMyBug plugin updates..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-router.js\" prompt",
            "timeout": 5,
            "statusMessage": "Routing review through OhMyBug..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-router.js\" subagent",
            "timeout": 5,
            "statusMessage": "Loading OhMyBug review rules..."
          }
        ]
      }
    ]
  }
}
